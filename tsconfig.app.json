{
  "extends": ["@virtual-live-lab/tsconfig/vite", "@virtual-live-lab/tsconfig/react"],
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "vite-plus/client",
      "unplugin-icons/types/react",
      "./worker-configuration.d.ts"
    ],
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "workers/**/*",
    "env.d.ts",
    "worker-configuration.d.ts"
  ]
}
